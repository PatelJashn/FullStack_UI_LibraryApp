# Google OAuth Configuration
# Copy this file to .env.google and fill in your actual values

# Google OAuth Setup Instructions:
# 1. Go to https://console.cloud.google.com
# 2. Create a new project or select existing one
# 3. Enable the Google+ API
# 4. Go to Credentials → Create Credentials → OAuth 2.0 Client IDs
# 5. Set Application type to "Web application"
# 6. Add these Authorized redirect URIs:
#    - https://cloud.appwrite.io/v1/account/sessions/oauth2/callback/google/[YOUR_PROJECT_ID]
#    - http://localhost:5173/auth/callback (for development)
# 7. Copy your Client ID and paste it below

# Google OAuth Client ID (REQUIRED)
VITE_GOOGLE_CLIENT_ID=824311414153-u542i12qjvm1k14uv0gvp9ic1i8a6ti1.apps.googleusercontent.com

# Optional: Google OAuth Scopes (if you need additional permissions)
# VITE_GOOGLE_SCOPES=openid,email,profile

# Optional: Custom redirect URL (defaults to /auth/callback)
# VITE_GOOGLE_REDIRECT_URL=/auth/callback
